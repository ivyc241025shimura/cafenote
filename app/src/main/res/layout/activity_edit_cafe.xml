<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- ヘッダー -->
        <LinearLayout
            android:id="@+id/editCafeHeader"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="0dp"
            android:background="#6F4E37"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/buttonBackEdit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="← 戻る"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My Cafe Note"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonUpdateCafe"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="更新"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

    <!-- ここから下だけ24dpの余白 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- タイトル以降をここに入れる -->

        <!-- タイトル -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="カフェ情報更新"
            android:textColor="#222222"
            android:textSize="22sp" />

        <!-- カフェ名 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="カフェ名"
            android:textColor="#5D4037" />

        <EditText
            android:id="@+id/editCafeNameUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="カフェ名"
            android:inputType="text"
            android:singleLine="true" />

        <!-- お気に入り -->
        <CheckBox
            android:id="@+id/checkFavoriteUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="お気に入り"
            android:textColor="#5D4037" />

        <!-- 住所 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="住所"
            android:textColor="#5D4037" />

        <EditText
            android:id="@+id/editAddressUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="住所"
            android:inputType="text"
            android:singleLine="true" />

        <!-- 訪問日 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="年    月    日"
            android:textColor="#5D4037" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editYearUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="年"
                android:inputType="number"
                android:maxLength="4" />

            <EditText
                android:id="@+id/editMonthUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="月"
                android:inputType="number"
                android:maxLength="2" />

            <EditText
                android:id="@+id/editDayUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="日"
                android:inputType="number"
                android:maxLength="2" />

        </LinearLayout>

        <!-- 評価 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="評価"
            android:textColor="#5D4037" />

        <RatingBar
            android:id="@+id/ratingBarUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="0"
            android:stepSize="1" />

        <!-- 写真 -->
        <Button
            android:id="@+id/buttonSelectPhotoUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="写真登録" />

        <TextView
            android:id="@+id/textSelectedPhotoTitleUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="写真"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSelectedPhotoUpdate"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- 食べたもの -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="食べたもの"
            android:textColor="#5D4037" />

        <EditText
            android:id="@+id/editFoodUpdate"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="食べたもの"
            android:inputType="textMultiLine" />

        <!-- memo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="memo"
            android:textColor="#5D4037" />

        <EditText
            android:id="@+id/editMemoUpdate"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="memo"
            android:inputType="textMultiLine" />

        <!-- 削除 -->
        <Button
            android:id="@+id/buttonDeleteCafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/transparent"
            android:text="削除"
            android:textColor="#B71C1C"
            android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>