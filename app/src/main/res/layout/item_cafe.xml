<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageCafe"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_cafe_photo"
        android:clipToOutline="true"
        android:contentDescription="カフェの写真"
        android:padding="2dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCafeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6F4E37"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#D9B99B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#6F4E37"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textVisitDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D9B99B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6F4E37"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>