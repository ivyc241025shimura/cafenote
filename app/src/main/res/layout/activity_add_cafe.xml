<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F2">

    <!-- ヘッダー -->
    <LinearLayout
        android:id="@+id/addCafeHeader"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="#6F4E37"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/buttonBackAdd"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text="← 戻る"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:translationY="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Cafe Note"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:translationY="12dp" />

        <Button
            android:id="@+id/buttonRegisterCafe"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text="登録"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:translationY="12dp" />

    </LinearLayout>


    <!-- 登録内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFF8F2"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- カフェ名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="カフェ名"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editCafeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="カフェ名を入力"
                android:inputType="text"
                android:textSize="16sp" />


            <!-- 住所 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="住所"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="住所を入力"
                android:inputType="text"
                android:textSize="16sp" />


            <!-- 訪問日 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="訪問日"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="年"
                    android:inputType="number"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="年"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/editMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="月"
                    android:inputType="number"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="月"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/editDay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="日"
                    android:inputType="number"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- 評価 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="評価"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1.0" />


            <!-- 写真 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="写真"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonSelectPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="写真を選択"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSelectedPhotoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="選択した写真"
                android:textColor="#6F4E37"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSelectedPhoto"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />


            <!-- 食べたもの -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="食べたもの"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editFood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="食べたものを入力"
                android:inputType="text"
                android:textSize="16sp" />


            <!-- メモ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="メモ"
                android:textColor="#6F4E37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editMemo"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:hint="メモを入力"
                android:inputType="textMultiLine"
                android:textSize="16sp" />


            <!-- お気に入り -->
            <CheckBox
                android:id="@+id/checkFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="お気に入りに登録"
                android:textSize="16sp" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>